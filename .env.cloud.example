# Minions na nuvem grátis (Vercel + Neon + Gemini) — ver docs/VERCEL.md
# Copie para .env.cloud (ignorado pelo git). As mesmas variáveis vão para o painel da Vercel,
# exceto NODE_ENV (a Vercel define sozinha). Somente DADOS FICTÍCIOS.
NODE_ENV=production
ALLOW_REAL_DATA=false

# Demonstração: login com usuários fictícios, sempre atrás do código de acesso
AUTH_MODE=dev
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Código que as pessoas digitam para entrar (mínimo 12 caracteres)
DEMO_ACCESS_CODE=

# Neon (região AWS São Paulo) — use a URL "Pooled connection" com sslmode=verify-full
DATABASE_URL=
PG_POOL_MAX=3
STORAGE_PROVIDER=db

# Gemini — chave grátis em https://aistudio.google.com/apikey (não ative faturamento)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Só no painel da Vercel (a rotina diária envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
SESSION_COOKIE_SECURE=true
