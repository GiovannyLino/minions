# ───────── Ambiente ─────────
NODE_ENV=development
# Mantenha false até concluir o checklist de docs/SECURITY.md §6
ALLOW_REAL_DATA=false

# ───────── API ─────────
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Banco: vazio = PGlite embutido em DATA_DIR. Ex.: postgres://minions:senha@127.0.0.1:5432/minions
DATABASE_URL=
DATA_DIR=.data
# Executa o worker de ingestão dentro do processo da API (dev). Em produção use `npm run worker -w @minions/api`.
EMBEDDED_WORKER=true

# ───────── Autenticação ─────────
# dev  = seleção de usuários fictícios (bloqueado em produção)
# oidc = Microsoft Entra ID (ou outro IdP OIDC)
AUTH_MODE=dev
# Segredo HS256 do modo dev e de links assinados (>= 32 caracteres). Gere: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
# Claim do IdP com os grupos / papéis
OIDC_GROUPS_CLAIM=groups
OIDC_ROLES_CLAIM=roles
# Escopo delegado exigido no access token (claim scp)
OIDC_REQUIRED_SCOPE=access_as_user
# Mapa objectId do grupo no Entra -> grupo do Minions. Ex.: {"<guid>":"comercial","<guid>":"engenharia"}
OIDC_GROUP_MAP=

# ───────── IA ─────────
# none      = modo extrativo: grátis, sem modelo, nenhum dado sai da máquina (padrão)
# ollama    = modelo LOCAL e gratuito via Ollama (instale em https://ollama.com e rode "ollama pull qwen2.5:7b")
# anthropic = Claude (pago por uso — só com orçamento aprovado)
LLM_PROVIDER=none
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# default | off — fallback de recusa do lado do servidor
AI_REFUSAL_FALLBACK=default
# hash (dev, lexical, grátis) | ollama (local, grátis — ex.: EMBEDDING_MODEL=bge-m3 e EMBEDDING_DIM=1024) | voyage | openai (pagos)
# Trocar de provedor/dimensão exige recriar o índice: npm run seed -w @minions/api -- --force (dev)
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=384
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ───────── Arquivos ─────────
MAX_UPLOAD_MB=25
# none (dev) | clamav
MALWARE_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ───────── Limites ─────────
RATE_LIMIT_PER_MINUTE=60
AGENT_MAX_CALLS=8
AGENT_MAX_DEPTH=2
AGENT_MAX_LLM_CALLS=6
AGENT_TIMEOUT_MS=60000
RETENTION_CONVERSATION_DAYS=180
RETENTION_AUDIT_DAYS=730

# ───────── Web (Next.js, server-side apenas) — copie estas linhas para apps/web/.env.local ─────────
API_URL=http://127.0.0.1:4000
SESSION_COOKIE_SECURE=false
# Login corporativo (Entra ID) no web — deixe vazio para usar o login de desenvolvimento.
# Para testar localmente sem Entra: npm run dev:sso (sobe um IdP de desenvolvimento já configurado)
APP_URL=http://localhost:3000
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Escopo da API solicitado pelo web, ex.: api://minions-api/access_as_user
OIDC_API_SCOPE=

# Confiar em X-Forwarded-For (a API fica atrás do BFF/proxy). Use false se exposta diretamente.
TRUST_PROXY=true
